# Copy to .env.local and fill in. Nothing here is a real secret.

# Postgres. On Neon, use the pooled connection string here.
DATABASE_URL=postgres://user:password@host/pelotaz
# Optional: a direct (non-pooled) connection for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_MIGRATIONS=

# Language model, as "<provider>:<model>". Providers wired in: anthropic, openai.
# Model lineups change; take the id from the provider's current models page.
# The matching key below is read by the provider package.
LLM_MODEL=anthropic:<model-id>
# Optional: a smaller, cheaper model for the review pass that audits each
# profile against the site. Same format. Unset means LLM_MODEL does both.
# LLM_MODEL_CRITIC=anthropic:<smaller-model-id>
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- La Pelota, the in-product assistant (private testing, not built yet) --
# Not live anywhere until ASSISTANT_ENABLED=true and the tenant is on the
# allowlist. See docs/pelota-assistant.md and docs/decisions.md.
# ASSISTANT_ENABLED=false
# Comma-separated tenant ids. Empty means nobody, even with the flag on.
# ASSISTANT_TENANTS=
# DeepInfra's OpenAI-compatible endpoint. Confirm on deepinfra.com before changing.
# ASSISTANT_BASE_URL=https://api.deepinfra.com/v1/openai
# ASSISTANT_API_KEY=
# Raw DeepInfra model ids (no "provider:" prefix; see docs/decisions.md for current picks).
# ASSISTANT_MODEL_FAST=deepseek-ai/DeepSeek-V4.1-Flash
# ASSISTANT_MODEL_STRONG=zai-org/GLM-5.2
# routed (default), fast_only or strong_only.
# ASSISTANT_MODE=routed
# Tool round-trips chat() allows before it must answer.
# ASSISTANT_MAX_TOOL_STEPS=4
# Milliseconds before a call is retried once, then given up on.
# ASSISTANT_TIMEOUT_MS=20000

# --- Sign-in ---------------------------------------------------------------
# Production: Neon Auth (managed Better Auth; users live in this database).
# In the Neon Console open Auth, enable it, and copy the Auth URL.
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/<db>/auth
# Resend key for the Spanish sign-up, sign-in and password emails. Only used
# once Neon Auth's webhooks point at /api/webhooks/neon-auth (see README).
# RESEND_API_KEY=re_...
# Generate with: openssl rand -base64 32
# NEON_AUTH_COOKIE_SECRET=

# Private pilot: only these addresses or whole domains get a workspace.
# Comma separated. Leave empty to let anyone who signs up in.
# SIGNUP_ALLOWLIST=you@example.com,@yourcompany.mx
# Who may approve access requests at /admin/solicitudes. Full addresses, comma
# separated. These people also need to be on SIGNUP_ALLOWLIST to sign in.
# ADMIN_EMAILS=you@example.com
# New access requests accepted per 24 hours from the public form (default 1000).
# ACCESS_REQUESTS_PER_DAY=1000

# Local development without Neon Auth: every request acts as this tenant.
# `npm run db:seed` prints a value for DEV_TENANT_ID.
# Ignored when the Neon Auth settings are present; refuses to run in a production build.
AUTH_MODE=dev
DEV_TENANT_ID=

# --- Safety limits per tenant (defaults shown) ------------------------------
# Each onboarding run costs a crawl and two model calls.
# MAX_BRANDS_PER_TENANT=5
# ONBOARDINGS_PER_DAY=10
# Weekly plans and post rewrites each tenant may start per 24 hours.
# PLANS_PER_DAY=6
# REWRITES_PER_DAY=40
# Proposals to update the brand profile from the owner's edits.
# LEARN_PER_DAY=5

# --- Publishing to Instagram and Facebook (optional) ---
# A Meta app of type Business with Facebook Login for Business.
# META_APP_ID=
# META_APP_SECRET=
# Facebook Login for Business configuration id; when set it replaces the scope list.
# META_LOGIN_CONFIG_ID=
# Encrypts channel tokens at rest. 32 random bytes: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=
# The site's public address (Meta fetches photos from it). On Vercel the production URL is used when unset.
# APP_URL=https://www.pelotaz.com
# Vercel Cron sends this as a Bearer token to /api/cron/publish. At least 32 characters.
# CRON_SECRET=

# Shared secret between schedulers (n8n, cron) and /api/internal/* and /api/cron/*. At least 32 characters.
# Generate one with: openssl rand -hex 32
INTERNAL_API_SECRET=

# When set, onboarding is handed to n8n (workflow n8n/01-onboard-brand.json).
# When empty, onboarding runs inside the Next.js process, which suits local development.
# N8N_ONBOARD_WEBHOOK_URL=

# Public page: the brand whose post counts appear under "Caso real" (Juanberto's).
# Leave unset to hide that section.
# CASE_STUDY_BRAND_ID=
