# Copy to .env.local and fill in. Nothing here is a real secret.

# Postgres. On Neon, use the pooled connection string here.
DATABASE_URL=postgres://user:password@host/pelotaz
# Optional: a direct (non-pooled) connection for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_MIGRATIONS=

# Language model, as "<provider>:<model>". Providers wired in: anthropic, openai.
# Model lineups change; take the id from the provider's current models page.
# The matching key below is read by the provider package.
LLM_MODEL=anthropic:<model-id>
# Optional: a smaller, cheaper model for the review pass that audits each
# profile against the site. Same format. Unset means LLM_MODEL does both.
# LLM_MODEL_CRITIC=anthropic:<smaller-model-id>
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Sign-in ---------------------------------------------------------------
# Production: Neon Auth (managed Better Auth; users live in this database).
# In the Neon Console open Auth, enable it, and copy the Auth URL.
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/<db>/auth
# Generate with: openssl rand -base64 32
# NEON_AUTH_COOKIE_SECRET=

# Private pilot: only these addresses or whole domains get a workspace.
# Comma separated. Leave empty to let anyone who signs up in.
# SIGNUP_ALLOWLIST=you@example.com,@yourcompany.mx

# Local development without Neon Auth: every request acts as this tenant.
# `npm run db:seed` prints a value for DEV_TENANT_ID.
# Ignored when the Neon Auth settings are present; refuses to run in a production build.
AUTH_MODE=dev
DEV_TENANT_ID=

# --- Safety limits per tenant (defaults shown) ------------------------------
# Each onboarding run costs a crawl and two model calls.
# MAX_BRANDS_PER_TENANT=5
# ONBOARDINGS_PER_DAY=10
# Weekly plans and post rewrites each tenant may start per 24 hours.
# PLANS_PER_DAY=6
# REWRITES_PER_DAY=40
# Proposals to update the brand profile from the owner's edits.
# LEARN_PER_DAY=5

# Shared secret between n8n and /api/internal/*. At least 32 characters.
# Generate one with: openssl rand -hex 32
INTERNAL_API_SECRET=

# When set, onboarding is handed to n8n (workflow n8n/01-onboard-brand.json).
# When empty, onboarding runs inside the Next.js process, which suits local development.
# N8N_ONBOARD_WEBHOOK_URL=
